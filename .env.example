# .env.local の雛形。コピーして値を入れる(.env.local は git 管理外)。
# Vercel の本番にも同じ名前で設定する。

# Supabase(必須)。ローカル Supabase なら http://127.0.0.1:54321 と `supabase status` の publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# /weather の地点(任意)。未設定なら東京駅
NEXT_PUBLIC_WEATHER_NAME=東京
NEXT_PUBLIC_WEATHER_LATITUDE=35.6812
NEXT_PUBLIC_WEATHER_LONGITUDE=139.7671

# npm run dev でリモート DB に自動ログインするときだけ(任意。ローカル Supabase では不要)
# DEV_AUTH_EMAIL=
# DEV_AUTH_PASSWORD=
# ログイン画面を確かめるときは 0
# DEV_AUTH_BYPASS=0

# scripts/upsert-reports.mjs 用。.env.local には置かず、実行時の環境変数で渡す(service_role は全権限)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
