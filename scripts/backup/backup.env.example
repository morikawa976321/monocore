# Copy this file to backup.env and fill the values.
# Do not commit backup.env (it contains secrets).

# Use Session pooler URI from Supabase Connect screen.
export PROD_DB_URL='postgresql://postgres.pfjqqhdxzadlpylsloyo:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require'
export BACKUP_DIR='/srv/backups/supabase'
export KEEP_GENERATIONS='10'
export DUMP_COMPRESSION='1'
export PG_CLIENT_MODE='auto'
export PG_DOCKER_IMAGE='postgres:17-alpine'
